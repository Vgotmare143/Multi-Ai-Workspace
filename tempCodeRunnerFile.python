def build_zip(destination_path: Path) -> None:
    destination_path.parent.mkdir(parents=True, exist_ok=True)
    with zipfile.ZipFile(destination_path, "w", zipfile.ZIP_DEFLATED) as zf:
        for rel_path, content in FILES.items():
            zf.writestr(rel_path, content)
    print(f"Successfully created Phase 10 archive at: {destination_path.resolve()}")


if __name__ == "__main__":
    dest = Path(sys.argv[1]).expanduser() if len(sys.argv) > 1 else DEFAULT_ZIP_DEST
    build_zip(dest)