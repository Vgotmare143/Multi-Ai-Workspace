# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/multi_ai_workspace

# Redis (Background Jobs & Rate-Limit State)
REDIS_URL=redis://localhost:6379/0

# Local Master Encryption Key (Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
VAULT_MASTER_KEY=dev-only-replace-in-production-32-byte-base64-key=

# Default Execution Mode (mock | web_bridge | api_key | local_ollama)
DEFAULT_CONNECTION_MODE=mock

# Optional Free-Tier / Local AI Endpoints (Leave blank if using Simulator or Web-Bridge)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
